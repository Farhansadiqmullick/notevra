{
  "name": "notevra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "pwa": "npm run build && npm run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:preview": "E2E_TARGET=preview playwright test",
    "test:ui:regress": "playwright test --grep-invert @known",
    "test:ui:report": "playwright show-report e2e-report",
    "test:all": "npm run test && npm run test:ui",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:version": "bash scripts/deploy-version.sh",
    "release:tag": "bash scripts/release-tag.sh",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "tauri icon public/icons/pwa-512.png",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/gen-seed.mjs",
    "db:seed:users": "node scripts/seed-dev-users.mjs",
    "db:status": "supabase status",
    "db:diff": "supabase db diff -f",
    "db:verify": "bash supabase/tests/sync-scenarios.sh",
    "db:prod:login": "npx supabase login && npx supabase link --project-ref xkarfcsghyfvvawmclkd",
    "db:push": "npx supabase db push"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@noble/hashes": "^2.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "dexie": "^4.0.8",
    "fflate": "^0.8.3",
    "pinia": "^2.2.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "supabase": "^2.115.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
