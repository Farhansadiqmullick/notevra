# Copy to .env.local and fill in. `.env.local` is gitignored; this file is not.
#
# BOTH MAY BE LEFT EMPTY. With no values the app runs local-only: every note still saves to
# IndexedDB, and Settings says "Local only" instead of offering a sign-in that cannot work. That is
# a supported way to run BlocNote, not a broken build — auth buys sync and sharing, never editing.
#
# For local development, `npm run db:status` prints both values. They are fixed demo credentials,
# identical on every machine that runs the Supabase CLI, and safe to paste anywhere.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Absolute origin that confirmation and password-reset emails return to. OPTIONAL — leave it empty
# and the app uses whatever origin it is being served from, which is correct for `npm run dev`,
# `npm run preview` and branch previews alike.
#
# Set it for a real deployment (in `.env.production`, since VITE_ vars are baked in at build time),
# and then set the SAME string in Supabase → Authentication → URL Configuration → Redirect URLs.
# Both halves are required. Supabase validates this value against that allow-list and, on no match,
# silently falls back to the project's Site URL — which on a fresh project is `http://localhost:3000`.
# The email still sends, the token in it is still valid, and it drops the user on a dead address.
VITE_SITE_URL=

# Settings → Sync & Storage → the "Sync diagnostics" card and the "Developer — Stage a conflict"
# card. OPTIONAL — unset shows them on `npm run dev` and hides them in every build. `true` forces
# them on, `false` forces them off. Real conflicts ("Changes to review") always show.
VITE_SYNC_DIAGNOSTICS=

# NEVER put the service role key in a VITE_ variable, or in this repo at all.
#
# Anything prefixed VITE_ is inlined into the JavaScript bundle and served to every visitor — that
# is the whole point of the prefix. The anon key is designed for that: it identifies the project and
# grants nothing on its own, because RLS decides what it can reach (and `anon` was granted no DML at
# all — see design/local-database.md). The service role key BYPASSES RLS entirely. In a browser
# bundle it hands every visitor every row in the database.
